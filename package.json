{
  "name": "weather-browser-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "check": "tsc -b && npm run check:boundaries",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b && vite build",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:deployment": "node scripts/check-pages-output.mjs && node scripts/verify-local-production.mjs",
    "test:dependencies": "node scripts/check-dependency-policy.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility",
    "test:performance:interactions": "node scripts/run-interactions.mjs",
    "test:performance:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:deployed": "playwright test tests/e2e tests/accessibility",
    "verify": "npm run check && npm run test:coverage && npm run build && npm run test:bundle && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-vitals": "^6.2.3"
  }
}
